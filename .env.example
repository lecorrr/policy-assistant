# Copy to .env, or let `policy-assistant setup` write it with generated values.

# Postgres. Docker Compose uses the admin password for the database container; init-db creates
# the reader role with the reader password.
POLICY_DB_ADMIN_PASSWORD=
POLICY_DB_READER_PASSWORD=
# POLICY_DB_HOST=127.0.0.1
# POLICY_DB_PORT=5442

# Signs the web page's session cookie: 32 characters or more.
POLICY_SESSION_SECRET=
# POLICY_SESSION_HOURS=8
# POLICY_COOKIE_SECURE=false

# Cloud answer models; leave empty to use only the local one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search. These are the defaults.
# POLICY_OLLAMA_URL=http://127.0.0.1:11434
# POLICY_EMBEDDING_MODEL=bge-m3
# POLICY_EMBEDDING_DIMS=1024
# POLICY_RERANKER=BAAI/bge-reranker-v2-m3-int8
# POLICY_RERANKER_THREADS=
# POLICY_CANDIDATES=30
# POLICY_RERANK_TOP=20
# POLICY_TOP_K=5
# POLICY_CHUNK_CHARS=1200
# POLICY_REQUEST_TIMEOUT_S=120
